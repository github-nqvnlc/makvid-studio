  "script": [
    {
      "id": "s1",
      "text": "Bạn có biết tiền có thể tự đẻ ra tiền?"
    },
    {
      "id": "s2",
      "text": "Đó chính là sức mạnh của lãi kép."
    },
    {
      "id": "s3",
      "text": "Lãi kép là khi tiền lãi tiếp tục sinh ra tiền lãi."
    },
    {
      "id": "s4",
      "text": "Bạn chỉ cần ba thứ: vốn ban đầu, lãi suất và thời gian."
    },
    {
      "id": "s5",
      "text": "So với lãi đơn, lãi kép tăng nhanh hơn mỗi năm."
    },
    {
      "id": "s6",
      "text": "Gửi mười triệu với lãi tám phần trăm, sau mười năm bạn có hai mươi mốt triệu sáu."
    },
    {
      "id": "s7",
      "text": "Albert Einstein từng gọi lãi kép là kỳ quan thứ tám của thế giới."
    },
    {
      "id": "s8",
      "text": "Hãy bắt đầu tiết kiệm ngay hôm nay. Ẩn số quan trọng nhất là thời gian."
    }
  ],
