{
  "name": "makvid-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/license-check.mjs",
    "makvid": "pnpm --filter @makvid/cli exec tsx src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/scripts/migrate.ts",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:mock": "node scripts/dev-stack.mjs --mock"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/exo-2": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@makvid/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "lucide-static": "1.63.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
