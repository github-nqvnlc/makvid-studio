# Copy to .env and fill in. Never commit .env.

# --- Database (docker/compose.dev.yml defaults) ---
POSTGRES_USER=makvid
POSTGRES_PASSWORD=makvid-dev
POSTGRES_DB=makvid
POSTGRES_PORT=5432
DATABASE_URL=postgres://makvid:makvid-dev@localhost:5432/makvid

# --- Queue (Valkey, Redis protocol) ---
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379

# --- Object storage (S3 API: SeaweedFS in dev; R2/S3 in prod) ---
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=makvid-dev
S3_ACCESS_KEY_ID=makvid-dev-access
S3_SECRET_ACCESS_KEY=makvid-dev-secret-change-me
S3_FORCE_PATH_STYLE=true

# --- LLM (benchmark: bench/llm; ADR pending). Only providers with a key are used. ---
# FPT AI Marketplace (same key as TTS). Model names are case-sensitive, as listed by GET /v1/models.
FPT_LLM_MODELS=gemma-4-26B-A4B-it,gpt-oss-120b,gemma-4-31B-it,Qwen3.6-27B,DeepSeek-V4-Flash,DeepSeek-V4.1-Flash
# OpenAI: https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODELS=
# Google Gemini API (OpenAI-compatible endpoint https://generativelanguage.googleapis.com/v1beta/openai/)
GEMINI_API_KEY=
GEMINI_MODELS=
# AI images in scenes (ADR 0011): off (default, zero cost) | mock | provider order, e.g. shopaikey,google
# (the next provider is used when one is down or refuses the key)
MAKVID_MEDIAGEN=off
# ShopAIKey (key reseller, chosen for production by the product owner): key, model, USD per image for cost logs
SHOPAIKEY_API_KEY=
SHOPAIKEY_IMAGE_MODEL=
SHOPAIKEY_IMAGE_COST_USD=0.026
# Optional Google model override (default gemini-nano-banana-2.1)
MAKVID_MEDIAGEN_MODEL=
# Anthropic Claude API (Console API key; NOT a Claude Code / Claude.ai subscription login)
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-opus-5-5

# --- TTS (ADR 0002: FPT AI Marketplace, OpenAI-compatible) ---
FPT_AI_API_KEY=
FPT_TTS_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_TTS_MODEL=FPT.AI-VITs
FPT_TTS_VOICE=banmai

# --- Rendering ---
RENDER_WORKERS=4
RENDER_FPS=30

# --- Logging ---
LOG_LEVEL=info
ALIGN_URL=http://localhost:8090

# --- Licensed music (ADR 0007): Soundstripe API key (server-side only). Empty = procedural beds. ---
SOUNDSTRIPE_API_KEY=

# Web app (M3)
BETTER_AUTH_SECRET=change-me-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared work directory for web + workers (per-project state, caches, outputs before upload)
WORK_ROOT=
# Optional BullMQ key prefix (default "mkv")
QUEUE_PREFIX=
# 1 = mock LLM/TTS/aligner/renderer everywhere (end-to-end tests without paid calls)
MAKVID_MOCK_PROVIDERS=0
