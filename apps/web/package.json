{
  "name": "@makvid/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js web app (M3): bilingual UI, auth, projects, chat edits, review, downloads",
  "scripts": {
    "dev": "node ../../scripts/dev-stack.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "dev:web": "next dev --port 3000"
  },
  "devDependencies": {
    "@makvid/config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@makvid/renderer": "workspace:*"
  },
  "dependencies": {
    "@makvid/ai": "workspace:*",
    "@makvid/db": "workspace:*",
    "@makvid/pipeline": "workspace:*",
    "@makvid/queue": "workspace:*",
    "@makvid/spec": "workspace:*",
    "@makvid/storage": "workspace:*",
    "@makvid/tts": "workspace:*",
    "@makvid/ui": "workspace:*",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  }
}
